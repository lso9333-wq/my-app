# XMSK 탭 잠금 해제용 비밀번호. 트레이너에게 공유하는 값.
# 미설정 시 server/xmskAuth.ts의 개발용 기본값('forestretch1')이 사용되므로
# 운영 배포 환경에서는 반드시 별도 값으로 설정할 것.
XMSK_PASSWORD=

# XMSK 인증 토큰 서명에 쓰이는 비밀키. 사람이 입력하는 값이 아니므로
# 무작위 문자열(예: `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`)로 생성.
# 미설정 시 개발용 기본값이 사용되므로 운영 배포 환경에서는 반드시 별도 값으로 설정할 것.
XMSK_SECRET=
